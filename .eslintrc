{
  "extends": "standard-with-typescript",
  "rules": {
    "no-extra-semi": "error",
    "semi": [
      "error",
      "always"
    ],
    "quotes": [
      "error",
      "double",
      {
        "allowTemplateLiterals": true
      }
    ],
    "@typescript-eslint/semi": [
      "error",
      "always"
    ],
    "@typescript-eslint/quotes": [
      "error",
      "double",
      {
        "allowTemplateLiterals": true
      }
    ],
    "import/order": [
      "error",
      {
        "newlines-between": "always"
      }
    ]
  },
  "parserOptions": {
    "project": "./tsconfig.json"
  }
}