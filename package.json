{
  "name": "markdown-repository",
  "version": "1.1.3",
  "description": "Use markdown files like a database. Firestore-style query builder for .md and .mdx files with frontmatter.",
  "keywords": [
    "markdown",
    "mdx",
    "frontmatter",
    "repository",
    "query",
    "cms",
    "content",
    "gray-matter",
    "static-site",
    "firestore"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/varstatt/markdown-repository.git"
  },
  "homepage": "https://github.com/varstatt/markdown-repository#readme",
  "bugs": {
    "url": "https://github.com/varstatt/markdown-repository/issues"
  },
  "author": "Jurij Tokarski <jurij@varstatt.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --modulePaths=src",
    "test:coverage": "jest --modulePaths=src --coverage",
    "test:watch": "jest --modulePaths=src --watch",
    "lint": "biome check src/",
    "format": "biome check --write src/",
    "prepack": "npm run build"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.0"
  }
}
